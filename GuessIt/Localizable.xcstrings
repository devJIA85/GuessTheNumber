          }
        }
      }
    },
    "hint.fallback.exact" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last guess had correct positions. Keep a few digits fixed and swap some others to narrow down which positions were right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu último intento acertaste posiciones. Dejá algunos dígitos fijos y cambiá otros para acotar cuáles estaban bien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na última tentativa, você acertou a posição de alguns dígitos. Mantenha alguns no lugar e troque os outros para descobrir quais posições estavam certas."
          }
        }
      }
    },
    "hint.fallback.first_guess" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a first guess with different digits to learn which ones might belong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probá un primer intento con dígitos distintos para descubrir cuáles podrían estar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma primeira tentativa com dígitos diferentes para descobrir quais podem fazer parte do número secreto."
          }
        }
      }
    },
    "hint.fallback.misplaced" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last guess had at least one correct digit in the wrong place. Try moving some digits while keeping others fixed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu último intento hubo al menos un dígito correcto fuera de lugar. Mové algunos dígitos y dejá otros fijos para comparar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na última tentativa, pelo menos um dígito estava em outro lugar. Mude a posição de alguns dígitos e mantenha os outros no lugar para comparar."
          }
        }
      }
    },
    "hint.fallback.none_match" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of the digits from your last guess belong. Try digits you left out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún dígito de tu último intento está en el secreto. Probá con los que dejaste afuera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dígito da última tentativa está no número secreto. Experimente os dígitos que ficaram de fora."
          }
        }
      }
    },
    "hint.fallback.repeated" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
